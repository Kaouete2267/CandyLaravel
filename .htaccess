<IfModule mod_rewrite.c>
    RewriteEngine On

    # Quand le domaine pointe sur la racine du projet (hébergement OVH, WAMP sans VirtualHost),
    # toutes les requêtes sont servies par public/ : réécriture interne, l'URL affichée ne change pas.
    # Rien en dehors de public/ n'est accessible (.env, storage, vendor, modules…).
    # Avec un VirtualHost dont le DocumentRoot pointe sur public/, ce fichier n'est jamais lu.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
